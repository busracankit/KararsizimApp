# Yerel geliştirme için .env'ye kopyala. .env asla commit edilmez.
DJANGO_SECRET_KEY=degistir-beni
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Prod'da tam adres: DJANGO_ALLOWED_HOSTS=kararsizim-liard.vercel.app, DJANGO_CSRF_TRUSTED_ORIGINS=https://kararsizim-liard.vercel.app

# Boş bırakılırsa yerelde SQLite kullanılır.
# Supabase: Dashboard > Connect > Transaction pooler (port 6543) dizesi:
# DATABASE_URL=postgresql://postgres.<proje-ref>:<parola>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase Storage (seçenek görselleri). URL gizli değil; service/secret key GİZLİDİR.
# SUPABASE_URL=https://mzggagkmnkajelekvnxr.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# E-posta (parola sıfırlama). RESEND_API_KEY varsa Resend, yoksa EMAIL_HOST ile SMTP, ikisi de yoksa konsol.
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=Kararsızım <onboarding@resend.dev>
